<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_club" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.club</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email-alias-setting']/span" position="before">
                <field name="mail_local_part" placeholder="e.g. custom.mail.address"/>
            </xpath>
        </field>
    </record>
</odoo>
