<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- form view(s) -->
    <record id="membership_view_form_club_account" model="ir.ui.view">
        <field name="name">membership form club account</field>
        <field name="model">membership</field>
        <field name="inherit_id" ref="club.membership_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//h1" position="before">
                <field name="invoice_other_membership_ids" invisible="1"/>
                <field name="payment_state" invisible="1"/>
                <field name="move_type" invisible="1"/>
                <!-- Payment status for invoices / receipts
                     (extract from `account.view_move_form`) -->
                <span invisible="not active">
                    <widget name="web_ribbon" title="Paid" invisible="(payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))"/>
                    <widget name="web_ribbon" title="In Payment" invisible="(payment_state != 'in_payment' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))"/>
                    <widget name="web_ribbon" title="Partial" invisible="(payment_state != 'partial' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))"/>
                    <widget name="web_ribbon" title="Reversed" bg_color="bg-danger" invisible="payment_state != 'reversed'"/>
                    <widget name="web_ribbon" text="Invoicing App Legacy" bg_color="bg-info" tooltip="This entry has been generated through the Invoicing app, before installing Accounting. It has been disabled by the 'Invoicing Switch Threshold Date' setting so that it does not impact your accounting." invisible="payment_state != 'invoicing_legacy'"/>
                </span>
            </xpath>
            <xpath expr="//button[@name='validate_membership_payment']" position="attributes">
                <attribute name="string">Validate Invoice</attribute>
                <attribute name="invisible">((state not in ('requested', 'member') or payment_state in ('in_payment', 'paid')) or invoice_other_membership_ids != [])</attribute>
            </xpath>
            <xpath expr="//button[@name='validate_membership_payment']" position="after">
                <button name="validate_membership_payment" type="object" string="Validate Invoice" class="btn-primary" confirm="Other memberships are linked to the same invoice. Doing a payment receipt will also pay these memberships." invisible="((state not in ('requested', 'member') or payment_state in ('in_payment', 'paid')) or invoice_other_membership_ids == [])"/>
            </xpath>
            <xpath expr="//field[@name='price_paid']" position="after">
                <div class="alert alert-info o_form_label" role="alert" colspan="2" invisible="(payment_state != 'partial' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))"><strong>Price Paid:</strong> refer to the invoice</div>
            </xpath>
            <xpath expr="//field[@name='price_paid']" position="attributes">
                <attribute name="invisible">(move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and payment_state == 'partial')</attribute>
            </xpath>
            <xpath expr="//field[@name='price_due']" position="after">
                <field name="invoice_id"/>
            </xpath>
        </field>
    </record>
</odoo>
